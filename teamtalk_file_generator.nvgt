file f;
string filename, ttname, ttaddress, tcpport, udpport, username, password, nickname, channel, channelpass;
int encrypted;
void main() {
ttname=input_box("TeamTalk file generator", "Enter the server name.");
if(ttname=="") {
exit(); }
if(get_last_error()==-12) {
exit(); }
ttaddress=input_box("TeamTalk file generator", "Enter the server address.");
if(ttaddress=="") {
exit(); }
if(get_last_error()==-12) {
exit(); }
tcpport=input_box("TeamTalk file generator", "Enter the TCP port.", "10333");
if(tcpport=="") {
exit(); }
if(get_last_error()==-12) {
exit(); }
udpport=input_box("TeamTalk file generator", "Enter the UDP port.", tcpport);
if(udpport=="") {
exit(); }
if(get_last_error()==-12) {
exit(); }
encrypted=question("TeamTalk file generator", "Is the server encrypted?");
username=input_box("TeamTalk file generator", "Enter the username.");
if(get_last_error()==-12) {
exit(); }
password=input_box("TeamTalk file generator", "Enter the user's password.");
if(get_last_error()==-12) {
exit(); }
nickname=input_box("TeamTalk file generator", "Enter a nickname (optional).");
if(get_last_error()==-12) {
exit(); }
channel=input_box("TeamTalk file generator", "Enter the channel the user should join (optional).");
if(get_last_error()==-12) {
exit(); }
if(channel!="") {
channelpass=input_box("TeamTalk file generator", "Enter the channel password.");
if(get_last_error()==-12) {
exit(); } }
filename=save_file_dialog("TeamTalk Host Settings (*.tt):tt");
if(filename.empty()) exit();
f.open(filename+".tt", "w");
f.write("<?xml version=\"1.0\" encoding=\"UTF-8\" ?>\r<!DOCTYPE teamtalk>\r<teamtalk version=\"5.0\">\r <host>\r  <name>"+ttname+"</name>\r  <address>"+ttaddress+"</address>\r  <tcpport>"+tcpport+"</tcpport>\r  <udpport>"+udpport+"</udpport>\r");
if(encrypted==1) {
f.write("  <encrypted>true</encrypted>\r"); }
else {
f.write("  <encrypted>false</encrypted>\r"); }
f.write("  <auth>\r   <username>"+username+"</username>\r   <password>"+password+"</password>\r   <nickname>"+nickname+"</nickname>\r  </auth>\r");
if(channel!="") f.write("  <join>\r   <channel>"+channel+"</channel>\r   <password>"+channelpass+"</password>\r  </join>\r");
f.write(" </host>\r</teamtalk>\r");
f.close();
alert("Success", "File generated successfully.");
exit(); }